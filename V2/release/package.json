{
  "name": "prisma-form-pro",
  "version": "1.7.0",
  "description": "Manufacturing Weighing and Mixing Application",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "npm run build && npm run server",
    "start-server": "start-server.bat",
    "stop-server": "stop-server.bat",
    "build:package": "node build-package.js",
    "package": "build-package.bat",
    "build:installer": "iscc installer.iss"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.263.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "quagga": "^0.12.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^3.1.0",
    "vite": "^4.1.0"
  },
  "pkg": {
    "scripts": [
      "server.js"
    ],
    "assets": [
      "database/**/*",
      "shared/**/*",
      "server/**/*",
      "package.json"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "release"
  }
